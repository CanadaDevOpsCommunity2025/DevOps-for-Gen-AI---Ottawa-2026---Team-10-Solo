# Copy to .env (or set these as real environment variables / systemd
# Environment= lines) before running in anything other than local dev.

NODE_ENV=production
PORT=4000

# Required in production — auth.js refuses to start without this when
# NODE_ENV=production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SENTINEL_JWT_SECRET=

# Used by `npm run seed` — override before seeding a deployment anyone
# outside your own machine can reach. If unset, falls back to the local-dev
# defaults (admin123 / compliance123) and prints a warning.
SENTINEL_ADMIN_PASSWORD=
SENTINEL_COMPLIANCE_PASSWORD=
