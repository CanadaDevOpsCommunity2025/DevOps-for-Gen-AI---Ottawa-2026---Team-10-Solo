[Unit]
Description=Flight Recorder console (RAG traffic generator + RCA dashboard)
After=network.target sentinel.service

[Service]
Type=simple
User=sentinel
WorkingDirectory=/opt/sentinel-app/flight-recorder
ExecStart=/opt/sentinel-app/flight-recorder/.venv/bin/python server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
