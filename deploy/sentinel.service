[Unit]
Description=Sentinel observability platform (backend + dashboard)
After=network.target

[Service]
Type=simple
User=sentinel
WorkingDirectory=/opt/sentinel-app/platform
EnvironmentFile=/opt/sentinel-app/platform/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
